.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 100;
  pointer-events: none;
  transition: background 0.3s ease;
}

.drawer-mask-visible {
  background: rgba(0, 0, 0, 0.5);
  pointer-events: auto;
}

.drawer-container {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 85vh;
  background: rgba(255, 253, 249, 0.98);
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  display: flex;
  flex-direction: column;
}

.drawer-container-visible {
  transform: translateY(0);
}

.drawer-drag-handle {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 14rpx 0 10rpx;
  flex-shrink: 0;
}

.drawer-drag-indicator {
  width: 88rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #D9CCC0;
}

.drawer-header {
  padding: 0 28rpx 20rpx;
  border-bottom: 1rpx solid rgba(230, 217, 203, 0.5);
  flex-shrink: 0;
}

.drawer-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.drawer-shop-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.drawer-shop-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.drawer-shop-address {
  font-size: 24rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.drawer-body {
  flex: 1;
  overflow-y: auto;
  padding: 0 28rpx;
}

.section {
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(230, 217, 203, 0.3);
}

.section:last-child {
  border-bottom: none;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.char-count {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.char-count-warning {
  color: #FF7043;
}

.rating-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.rating-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 12rpx;
  background: #fff;
  border: 2rpx solid #E0E0E0;
  border-radius: 20rpx;
  transition: all 0.2s ease;
}

.rating-btn-selected {
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.rating-btn-1.rating-btn-selected {
  background: #9E9E9E;
}

.rating-btn-2.rating-btn-selected {
  background: #78909C;
}

.rating-btn-3.rating-btn-selected {
  background: #66BB6A;
}

.rating-btn-4.rating-btn-selected {
  background: #FF7043;
}

.rating-btn-5.rating-btn-selected {
  background: #FFCA28;
}

.rating-emoji {
  font-size: 48rpx;
  margin-bottom: 6rpx;
  line-height: 1;
}

.rating-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
  line-height: 1;
}

.rating-btn-selected .rating-label {
  color: #fff;
}

.category-scroll {
  white-space: nowrap;
}

.category-tags {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 0;
}

.category-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  min-height: 64rpx;
  background: #fff;
  border: 1rpx solid #E0E0E0;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  transition: all 0.2s ease;
}

.category-tag-selected {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #fff;
}

.comment-input {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  background: #fff;
  border: 1rpx solid #E0E0E0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.5;
  box-sizing: border-box;
}

.comment-input::placeholder {
  color: var(--text-tertiary);
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-add-btn {
  width: 180rpx;
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border: 2rpx dashed #D9CCC0;
  border-radius: 16rpx;
}

.image-add-icon {
  font-size: 64rpx;
  color: #D9CCC0;
  line-height: 1;
}

.image-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}

.image-preview {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.image-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
}

.uploading-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.drawer-footer {
  padding: 20rpx 28rpx 40rpx;
  flex-shrink: 0;
  background: rgba(255, 253, 249, 0.98);
  border-top: 1rpx solid rgba(230, 217, 203, 0.5);
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: #E0E0E0;
  border: none;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  line-height: 96rpx;
}

.submit-btn-active {
  background: linear-gradient(135deg, #C97D77, #B86A59);
}

.submit-btn-loading {
  background: #B86A59;
  opacity: 0.8;
}

.submit-btn::after {
  border: none;
}
