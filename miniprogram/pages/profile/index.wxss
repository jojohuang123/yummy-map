.page-shell {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 120rpx;
}

.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 24rpx 32rpx;
  background: linear-gradient(180deg, #F7F2EA 0%, var(--bg-page) 100%);
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(52, 42, 36, 0.1);
  margin-bottom: 16rpx;
}

.avatar-icon {
  font-size: 64rpx;
}

.profile-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.stats-section {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 24rpx 24rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(52, 42, 36, 0.04);
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat-value {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--color-primary);
  line-height: 1;
}

.stat-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.stat-unit {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.stat-divider {
  width: 1rpx;
  height: 80rpx;
  background: var(--line-soft);
  margin: 0 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.filter-btn {
  font-size: 26rpx;
  color: var(--color-primary);
  padding: 8rpx 16rpx;
}

.checkins-section {
  margin: 0 24rpx;
}

.filter-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.filter-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 0 16rpx;
  min-height: 48rpx;
  background: rgba(201, 125, 119, 0.1);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--color-primary);
}

.checkin-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.checkin-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(52, 42, 36, 0.04);
}

.checkin-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.checkin-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.3;
}

.checkin-rating {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  padding: 0 14rpx;
  min-height: 48rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.checkin-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.checkin-divider {
  color: var(--text-tertiary);
}

.checkin-comment {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.checkin-images {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.checkin-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.checkin-footer {
  display: flex;
  justify-content: flex-end;
}

.checkin-date {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.empty-btn {
  background: linear-gradient(135deg, #C97D77, #B86A59);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
  border-radius: 40rpx;
  padding: 0 48rpx;
  min-height: 80rpx;
  line-height: 80rpx;
}

.empty-btn::after {
  border: none;
}

.loading-state {
  display: flex;
  justify-content: center;
  padding: 40rpx;
  color: var(--text-tertiary);
  font-size: 26rpx;
}

.filter-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 100;
  pointer-events: none;
  transition: background 0.3s ease;
}

.filter-sheet-mask-visible {
  background: rgba(0, 0, 0, 0.5);
  pointer-events: auto;
}

.filter-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 70vh;
  background: #fff;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  padding-bottom: 60rpx;
}

.filter-sheet-visible {
  transform: translateY(0);
}

.filter-sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--line-soft);
}

.filter-sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.filter-sheet-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-tertiary);
}

.filter-section {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--line-soft);
}

.filter-section:last-child {
  border-bottom: none;
}

.filter-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.filter-tags-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-tag-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  min-height: 60rpx;
  background: #f5f0e8;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.filter-tag-btn-selected {
  background: var(--color-primary);
  color: #fff;
}
